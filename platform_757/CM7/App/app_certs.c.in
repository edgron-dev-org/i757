/* app_certs.c — generated by CMake from keys/ca/ (in build directory, not committed) — manual edits have no effect */
#include "app_certs.h"

const char app_tls_ca_pem[] =
@CA_PEM_C@;
const char app_tls_devcert_pem[] =
@DEVCERT_PEM_C@;
const char app_tls_devkey_pem[] =
@DEVKEY_PEM_C@;
/* firmware signature verification public key (public, not secret); private key keys/fwsign/fwsign.key kept on PC for signing */
const char app_fwsign_pub_pem[] =
@FWSIGN_PUB_C@;
/* anti-clone challenge-response verification public key (public); corresponding private key is inside 608B on production boards, in dev_se.key on Nucleo */
const char app_anticlone_pub_pem[] =
@ANTICLONE_PUB_C@;
/* Nucleo software SE emulation private key (dev only; production boards do not compile the software backend = does not contain this key) */
const char app_se_dev_key_pem[] =
@SE_DEV_KEY_C@;
/* AWS IoT trust anchor: Amazon Root CA 1 (public; used to verify server identity when connecting to AWS, trust anchor follows deployment) */
const char app_aws_ca_pem[] =
@AWS_CA_C@;

const size_t app_tls_ca_len      = sizeof(app_tls_ca_pem);
const size_t app_tls_devcert_len = sizeof(app_tls_devcert_pem);
const size_t app_tls_devkey_len  = sizeof(app_tls_devkey_pem);
const size_t app_fwsign_pub_len  = sizeof(app_fwsign_pub_pem);
const size_t app_anticlone_pub_len = sizeof(app_anticlone_pub_pem);
const size_t app_se_dev_key_len  = sizeof(app_se_dev_key_pem);
const size_t app_aws_ca_len      = sizeof(app_aws_ca_pem);
